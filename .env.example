# Copy this file to .env and adjust if needed.

# ---- server ----
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/applymate
# Any long random text. Used to sign login tokens.
JWT_SECRET=change-me-to-a-long-random-string

# ---- local LLM (Ollama) ----
LLM_URL=http://localhost:11434
LLM_MODEL=qwen3:4b
LLM_THINK=false

# ---- agent browser ----
# msedge (default) or chrome
AGENT_BROWSER_CHANNEL=msedge

# ---- email notifications (optional, see README) ----
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=yourname@gmail.com
# SMTP_PASS=your-16-letter-app-password
# MAIL_FROM="ApplyMate <yourname@gmail.com>"
# Address used for the buttons in emails (default http://localhost:PORT)
# APP_URL=http://localhost:5000
